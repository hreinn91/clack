# Copy to .env to change any of these. All are optional.

# Port and address the server listens on. 0.0.0.0 makes it reachable from
# other devices on your network; use 127.0.0.1 to keep it to this computer.
# CLACK_PORT=4317
# CLACK_HOST=0.0.0.0

# Where chat folders and remembered settings live. Defaults to ./data in this repository.
# Chats run in folders under <this>/sessions and nowhere else.
# CLACK_DATA_DIR=/path/to/data

# Access token for signing in. If unset, one is generated and saved in ~/.config/clack/token.
# CLACK_TOKEN=

# Minutes before an idle Claude Code process is shut down (the chat resumes on your next message).
# CLACK_IDLE_MINUTES=20

# Use a specific `claude` binary instead of the one bundled with the Agent SDK.
# CLACK_CLAUDE_PATH=
