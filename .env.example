# Copy to .env to change any of these. All are optional.

# Port and address the server listens on. 0.0.0.0 makes it reachable from
# other devices on your network; use 127.0.0.1 to keep it to this computer.
# CLACK_PORT=4317
# CLACK_HOST=0.0.0.0

# Where chat folders and remembered settings live. Defaults to ./data in this repository.
# Chats run in folders under <this>/sessions or in project folders added from the UI.
# CLACK_DATA_DIR=/path/to/data

# Access token for signing in. If unset, one is generated and saved in ~/.config/clack/token.
# CLACK_TOKEN=

# Minutes before an idle Claude Code process is shut down (the chat resumes on your next message).
# CLACK_IDLE_MINUTES=20

# Use a specific `claude` binary instead of the one bundled with the Agent SDK.
# CLACK_CLAUDE_PATH=

# The name your own messages are shown under. Defaults to the name of the
# account the server runs as.
# CLACK_USER_NAME=

# The Data page can open shells on this computer, running as your account.
# Set to off to remove that; the folder tree and file previews stay.
# CLACK_TERMINAL=off

# Chats can work in folders outside data/sessions that are added from the UI, which can also
# browse the folder names on this computer. Set to off to keep chats in data/sessions only.
# CLACK_OUTSIDE_FOLDERS=off

# Codex (OpenAI) as a second agent next to Claude. It is listed unless this is off; when the
# codex command is not installed (on the PATH, or at CLACK_CODEX_PATH), Codex shows as not
# available, like one that is not signed in, and clack runs on Claude alone. Sign in once with `codex login` (in Docker:
# docker compose exec clack codex login --device-auth).
# CLACK_CODEX=auto
# CLACK_CODEX_PATH=/opt/homebrew/bin/codex

# ---- Only with Docker (docker compose up -d) ----

# Where the data directory is on the host. Defaults to ./data beside docker-compose.yml.
# CLACK_DATA_PATH=/path/to/data

# The user the app runs as in the container. On a Linux host, set these to your
# own ids (`id -u` and `id -g`) so the files in the data directory belong to you.
# CLACK_UID=1000
# CLACK_GID=1000

# Let git and ssh in the container use the SSH agent on this computer. The
# private keys stay on the host. See "SSH keys" in docs/docker.md.
# COMPOSE_FILE=docker-compose.yml:docker-compose.ssh.yml
# On Linux, where the agent's socket is (Docker Desktop, OrbStack and colima
# started with --ssh-agent need nothing here):
# CLACK_SSH_AUTH_SOCK=/run/user/1000/ssh-agent.socket

# A way to sign Claude Code in without doing it inside the container:
# the long-lived token that `claude setup-token` prints on any computer.
# CLAUDE_CODE_OAUTH_TOKEN=
