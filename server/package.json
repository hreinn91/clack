{
  "name": "@clack/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/index.ts",
    "prestart": "node -e \"if (+process.versions.node.split('.')[0] < 24) { console.error('Clack requires Node.js 24 or newer. Found ' + process.version + '.'); process.exit(1) }\"",
    "start": "node --env-file-if-exists=../.env src/index.ts",
    "check": "tsc -p tsconfig.json",
    "codex:types": "codex app-server generate-ts --experimental --out codex-types",
    "test": "node --test test/"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.325",
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8",
    "node-pty": "^1.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
